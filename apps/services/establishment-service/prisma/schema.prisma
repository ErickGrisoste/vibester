generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Establishment {
  id              String   @id @default(uuid())
  googlePlaceId   String?  @unique
  name            String
  bio             String?
  endereco        String?
  photoUrl        String?
  bannerUrl       String?
  category        String
  priceIndicator  String?
  nivelMovimento  Int      @default(0)
  averageRating   Float    @default(0.0)
  qtdAvaliacoes   Int      @default(0)
  distribuicao    Float[]
  latitude        Float
  longitude       Float
  openingHours    EstablishmentOpeningHour[]
  images          EstablishmentImage[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([averageRating])
  @@index([latitude, longitude])
  @@index([name])
  @@map("establishments")
}

model EstablishmentImage {
  id              String        @id @default(uuid())
  establishmentId String
  url             String
  source          ImageSource   @default(SERPAPI)
  position        Int           @default(0)
  createdAt       DateTime      @default(now())

  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@map("establishment_images")
}

enum ImageSource {
  SERPAPI
  MANUAL
}

model EstablishmentOpeningHour {
  id              String        @id @default(uuid())
  establishmentId String
  dayOfWeek       Int
  openTime        String
  closeTime       String

  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@index([dayOfWeek])
  @@map("establishment_opening_hours")
}
