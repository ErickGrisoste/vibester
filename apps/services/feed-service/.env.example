ASTRA_CLIENT_ID=
ASTRA_CLIENT_SECRET=
ASTRA_SECURE_CONNECT_BUNDLE=
ASTRA_KEYSPACE=
ASTRA_TOKEN=

JWT_SECRET=

KAFKA_BROKERS=

# Opcionais — usados apenas para apontar para um Cassandra local (docker-compose.test.yml
# em CI, ou dev local) em vez do Astra Cloud. Deixe vazio em produção.
CASSANDRA_CONTACT_POINTS=
CASSANDRA_LOCAL_DATACENTER=

# Opcionais — CORS e rate limit (ver src/plugins.ts). CORS_ALLOWED_ORIGINS vazia
# faz o serviço aceitar qualquer origem (origin: true, com warn no log) — defina
# em produção com a lista de origens separadas por vírgula. RATE_LIMIT_MAX vazio
# usa o default de 300 req/min (store em memória, por réplica — ver CLAUDE.md).
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_MAX=

# Fatia do experimento ranking-v1 (0 a 1) entre quem está fora do holdout cronológico de 5%.
# Padrão 0 = feed rankeado desligado. Valor inválido também vira 0.
RANKING_ROLLOUT_SHARE=0
