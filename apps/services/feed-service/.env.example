ASTRA_CLIENT_ID=
ASTRA_CLIENT_SECRET=
ASTRA_SECURE_CONNECT_BUNDLE=
ASTRA_KEYSPACE=
ASTRA_TOKEN=

JWT_SECRET=

KAFKA_BROKERS=

# Opcionais — usados apenas para apontar para um Cassandra local (docker-compose.test.yml
# em CI, ou dev local) em vez do Astra Cloud. Deixe vazio em produção.
CASSANDRA_CONTACT_POINTS=
CASSANDRA_LOCAL_DATACENTER=

# Fatia do experimento ranking-v1 (0 a 1) entre quem está fora do holdout cronológico de 5%.
# Padrão 0 = feed rankeado desligado. Valor inválido também vira 0.
RANKING_ROLLOUT_SHARE=0
