# Modo do processo: "api" (endpoint de ingestão) ou "worker" (consumidor Kafka).
SERVICE_MODE=api
PORT=3007

# Mesmo segredo usado pelo auth-service para assinar o token.
JWT_SECRET=

# --- Cassandra ---
# Produção (DataStax Astra): preencher o bundle e as credenciais.
ASTRA_SECURE_CONNECT_BUNDLE=
ASTRA_CLIENT_ID=
ASTRA_CLIENT_SECRET=
ASTRA_KEYSPACE=

# Local/CI: definir CASSANDRA_CONTACT_POINTS dispensa as credenciais do Astra.
CASSANDRA_CONTACT_POINTS=
CASSANDRA_LOCAL_DATA_CENTER=datacenter1

# --- Kafka ---
KAFKA_BROKERS=

# --- Ajustes de coleta ---
# Dias de retenção do log bruto (TTL por linha).
INTERACTION_TTL_DAYS=90
# Máximo de eventos por requisição.
MAX_BATCH_SIZE=50
# Evento mais antigo que isto é rejeitado na API (relógio de cliente fora de sincronia).
MAX_EVENT_AGE_HOURS=24
# Escritas simultâneas por lote no Cassandra.
CASSANDRA_WRITE_CONCURRENCY=16
# Requisições por minuto por IP.
RATE_LIMIT_MAX=240
