PORT=3000

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

ASTRA_CLIENT_ID=
ASTRA_CLIENT_SECRET=
ASTRA_SECURE_CONNECT_BUNDLE=
ASTRA_KEYSPACE=
ASTRA_TOKEN=

# Só necessário para apontar pra um cluster Cassandra local/CI (docker-compose.test.yml)
# em vez do DataStax Astra. Se definido, ASTRA_SECURE_CONNECT_BUNDLE/CLIENT_ID/CLIENT_SECRET
# deixam de ser exigidos (ver src/config/cassandra.ts).
CASSANDRA_CONTACT_POINTS=
CASSANDRA_LOCAL_DATA_CENTER=datacenter1

KAFKA_BROKERS=localhost:9092

REDIS_URL=redis://localhost:6379