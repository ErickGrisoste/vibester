// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Access {
  id           String   @id @default(uuid())
  accountId    String   @unique
  username     String   @unique
  email        String   @unique
  passwordHash String
  // Preenchido pela moderação (POST /admin/accounts/:accountId/suspend).
  suspendedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]

  @@map("accesses")
}

// Uma linha por dispositivo logado. Guarda só o hash (SHA-256) do refresh
// token atual e do anterior: o token em si vive apenas no aparelho. A troca a
// cada refresh sobrescreve a linha em vez de criar outra, então a tabela cresce
// com o número de sessões ativas, não com o número de renovações.
model Session {
  id                String    @id @default(uuid())
  accountId         String
  tokenHash         String    @unique
  // Token que acabou de ser trocado. Reapresentado dentro da janela de
  // tolerância é reenvio legítimo; fora dela, sinal de roubo.
  previousTokenHash String?   @unique
  rotatedAt         DateTime?
  expiresAt         DateTime
  userAgent         String?
  createdAt         DateTime  @default(now())
  access            Access    @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("sessions")
}
